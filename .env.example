# Firebase Web App Configuration (Firebase Console -> Project Settings -> General)
VITE_FIREBASE_API_KEY=AIzaSyYourFirebaseApiKey
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# OpenAI Prototype Configuration (Direct Client-Side Mode)
VITE_OPENAI_API_KEY=sk-proj-your-openai-api-key
VITE_OPENAI_MODEL=gpt-4o-mini

# Optional Dev Bootstrap Flag (set to "true" only during initial Super Admin setup)
VITE_ENABLE_ADMIN_BOOTSTRAP=true
